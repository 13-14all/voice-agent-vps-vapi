# --- Vapi ---
VAPI_API_KEY=                                  # private key, for the REST API (provisioning)
VAPI_SERVER_SECRET=                            # shared secret Vapi sends back in x-vapi-secret header
PUBLIC_BASE_URL=https://your-vps-domain.com    # must be reachable by Vapi (TLS required)
# Derived automatically at runtime/provision time:
#   custom LLM -> {PUBLIC_BASE_URL}/vapi/chat/completions
#   server URL -> {PUBLIC_BASE_URL}/vapi/webhook

# --- Optional: bring-your-own Twilio number to import into Vapi ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- LLM (the brain behind the Vapi Custom LLM endpoint) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LOCAL_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
CLOUD_LLM_PROVIDER=openai
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=gpt-5

# --- Data ---
POSTGRES_URL=postgresql://voiceagent:voiceagent@localhost:5432/voiceagent

# --- App ---
APP_ENV=development
LOG_LEVEL=info
